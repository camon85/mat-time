  "removedHistory": {},
  "notes": {
    "2025-10-17": {
      "text": "토요일 오픈매트. 가볍게 플로우롤만",
      "tag": "오픈매트",
      "at": "2025-10-17T23:23:00.000Z"
    },
    "2025-12-03": {
      "text": "다나허 크로스 초크 인스트럭셔널. 그립을 먼저 깊게 넣는 게 전부",
      "tag": "video",
      "at": "2025-12-03T20:27:00.000Z"
    },
    "2025-12-12": {
      "text": "노기 스파링. 땀 때문에 자꾸 미끄러진다. 컨트롤을 몸으로 해야 함",
      "tag": "노기",
      "at": "2025-12-12T22:26:00.000Z"
    },
    "2025-12-15": {
      "text": "관장님 특강 — 경기 운영과 어드밴티지 관리. 지고 있을 때 뭘 해야 하는지",
      "tag": "seminar",
      "at": "2025-12-15T21:11:00.000Z"
    },
    "2025-12-24": {
      "text": "오픈매트에서 다른 관 사람들과. 스타일이 완전히 달라서 재밌었다",
      "tag": "오픈매트",
      "at": "2025-12-24T23:35:00.000Z"
    },
    "2025-12-31": {
      "text": "클로즈 가드 브레이크 → 니슬라이스 패스. 무릎을 상대 배에 먼저 얹어야 힘이 덜 든다",
      "tag": "class",
      "at": "2025-12-31T22:17:00.000Z"
    },
    "2026-01-16": {
      "text": "베림볼로 기초. 아직 회전 중에 방향을 잃는다",
      "tag": "class",
      "at": "2026-01-16T20:59:00.000Z"
    },
    "2026-02-04": {
      "text": "트라이앵글 셋업 — 각도를 45도 더 틀어야 잠긴다",
      "tag": "class",
      "at": "2026-02-04T20:19:00.000Z"
    },
    "2026-02-10": {
      "text": "지역 대회 · 2승 1패. 스탠딩이 여전히 문제. 테이크다운 연습 필요",
      "tag": "comp",
      "at": "2026-02-10T21:22:00.000Z"
    },
    "2026-03-04": {
      "text": "오늘은 컨디션이 별로라 드릴만 하고 스파링은 쉬었다",
      "tag": "etc",
      "at": "2026-03-04T23:13:00.000Z"
    },
    "2026-03-06": {
      "text": "하프가드 언더훅에서 스윕 두 가지. 상대 무게중심을 먼저 무너뜨릴 것",
      "tag": "class",
      "at": "2026-03-06T23:17:00.000Z"
    },
    "2026-03-11": {
      "text": "가드 리텐션 드릴 20분. 다리가 죽는 줄",
      "tag": "class",
      "at": "2026-03-11T21:50:00.000Z"
    },
    "2026-03-22": {
      "text": "체급 올려서 출전. 힘 차이가 확실히 느껴진다. 기술로 풀어야 함",
      "tag": "comp",
      "at": "2026-03-22T23:30:00.000Z"
    },
    "2026-04-03": {
      "text": "노기 클래스. 기가 없으니 그립이 안 잡혀서 완전히 다른 운동 같다",
      "tag": "노기",
      "at": "2026-04-03T21:43:00.000Z"
    },
    "2026-04-11": {
      "text": "오픈매트 5라운드. 상위 벨트한테 계속 눌렸지만 버티는 시간은 늘었다",
      "tag": "오픈매트",
      "at": "2026-04-11T20:35:00.000Z"
    },
    "2026-04-14": {
      "text": "미야오 형제 베림볼로 영상. 회전 타이밍을 다시 봐야겠다",
      "tag": "video",
      "at": "2026-04-14T22:03:00.000Z"
    },
    "2026-04-27": {
      "text": "고든 라이언 경기 분석. 패스할 때 상체 압박을 절대 안 뺀다",
      "tag": "video",
      "at": "2026-04-27T20:36:00.000Z"
    },
    "2026-05-04": {
      "text": "사이드 컨트롤 이스케이프 — 프레임 먼저, 새우는 그 다음. 순서 바꾸면 안 됨",
      "tag": "class",
      "at": "2026-05-04T21:59:00.000Z"
    },
    "2026-05-07": {
      "text": "혼자 깨달음: 프레임 먼저, 힘은 나중. 계속 반대로 하고 있었다",
      "tag": "etc",
      "at": "2026-05-07T20:23:00.000Z"
    },
    "2026-05-08": {
      "text": "데라히바 가드 진입 3종. 발목 훅 각도가 조금만 틀어져도 바로 털린다",
      "tag": "class",
      "at": "2026-05-08T20:26:00.000Z"
    },
    "2026-05-18": {
      "text": "패스 방어할 때 무릎 방패를 너무 늦게 세운다는 지적 받음",
      "tag": "class",
      "at": "2026-05-18T22:24:00.000Z"
    },
    "2026-05-25": {
      "text": "터틀 포지션에서 백 테이크. 오늘 처음으로 성공했다",
      "tag": "class",
      "at": "2026-05-25T22:55:00.000Z"
    },
    "2026-06-19": {
      "text": "암바 디테일: 다리로 머리를 눌러야 상대가 못 일어난다. 오늘 세 번 다 놓침",
      "tag": "class",
      "at": "2026-06-19T21:33:00.000Z"
    },
    "2026-06-22": {
      "text": "레그락 세미나. 힐훅 안전하게 걸고 푸는 법 위주로. 탭은 빨리",
      "tag": "seminar",
      "at": "2026-06-22T21:38:00.000Z"
    },
    "2026-07-01": {
      "text": "오픈매트 5라운드. 상위 벨트한테 계속 눌렸지만 버티는 시간은 늘었다",
      "tag": "오픈매트",
      "at": "2026-07-01T21:34:00.000Z"
    },
    "2026-07-03": {
      "text": "1년 전 영상과 비교해보니 가드 리텐션이 확실히 늘었다",
      "tag": "etc",
      "at": "2026-07-03T22:12:00.000Z"
    },
    "2026-07-04": {
      "text": "손가락 테이핑 시작. 그립 많이 쓰는 날은 필수",
      "tag": "etc",
      "at": "2026-07-04T22:22:00.000Z"
    },
    "2026-07-06": {
      "text": "백 컨트롤 훅 유지. 상대가 돌아누울 때 같이 따라가는 연습",
      "tag": "class",
      "at": "2026-07-06T23:31:00.000Z"
    },
    "2026-07-09": {
      "text": "유튜브에서 본 하프가드 시리즈. 언더훅 없이도 스윕 가능한 루트",
      "tag": "video",
      "at": "2026-07-09T22:43:00.000Z"
    },
    "2026-07-24": {
      "text": "체중 2kg 감량. 경기 체급 맞추려면 3kg 더",
      "tag": "etc",
      "at": "2026-07-24T22:37:00.000Z"
    },
    "2026-07-29": {
      "text": "히샤우 세미나 — 데라히바 가드 패스 3종.\n무릎 각도가 핵심이고 상대 힙을 먼저 죽여야 한다",
      "tag": "seminar",
      "at": "2026-07-29T23:43:00.000Z"
    },
    "2026-08-05": {
      "text": "레그락 방어 — 노기에서는 발을 빼는 타이밍이 훨씬 빠르다",
      "tag": "노기",
      "at": "2026-08-05T23:45:00.000Z"
    },
    "2026-08-07": {
      "text": "팀 대회 · 3승. 처음으로 서브미션으로 이겼다. 트라이앵글",
      "tag": "comp",
      "at": "2026-08-07T21:11:00.000Z"
    },
    "2026-08-08": {
      "text": "오픈 토너먼트 참가. 1회전 탈락했지만 상대가 결승 갔다. 나쁘지 않았음",
      "tag": "comp",
      "at": "2026-08-08T23:05:00.000Z"
    },
    "2026-08-10": {
      "text": "스파이더 가드 그립 유지가 관건. 손가락 힘이 먼저 빠진다",
      "tag": "class",
      "at": "2026-08-10T21:29:00.000Z"
    }
  },
